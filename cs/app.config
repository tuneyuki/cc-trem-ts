<?xml version="1.0" encoding="utf-8"?>
<!-- build.cmd が bin\ccterm-cs.exe.config としてコピーする -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <!-- 端末 1 つ分のヒープは小さいので、バックグラウンド GC の専用スレッドは要らない -->
    <gcConcurrent enabled="false" />
  </runtime>
</configuration>
